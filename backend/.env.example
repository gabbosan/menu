# Exemplo de variáveis de ambiente — NÃO commit valores reais aqui
# Copie este arquivo para `.env` e preencha com valores reais localmente

MONGODB_URI=
JWT_SECRET=
LOJISTA_PASSWORD=
CORS_ORIGIN=
# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
MONGODB_URI=mongodb://localhost:27017/menu

# CORS / Frontend
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Autenticação do lojista (usuário único fixo)
LOJISTA_USUARIO=loja
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
LOJISTA_SENHA_HASH=
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# Mercado Pago
MP_ACCESS_TOKEN=TEST-xxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx
WEBHOOK_URL=http://localhost:3000/webhooks/mercadopago
